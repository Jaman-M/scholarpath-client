/node_modules/
/.pnp
.pnp.*

# Yarn local files
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Test reports
/coverage/

# Next.js generated files
/.next/
/out/

# Production build output
/build/
/dist/

