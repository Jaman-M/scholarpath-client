/.cache/

# Environment variables and secrets
.env
.env.*
!.env.example

# Vercel local configuration
.vercel/

# Debug and error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# TypeScript generated files
*.tsbuildinfo
next-env.d.ts

# Operating system generated files
.DS_Store
Thumbs.db

# Local certificate files
*.pem